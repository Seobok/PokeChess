  m_Name: skill-hitmonlee
  m_EditorClassIdentifier: PokeChess.Content::PokeChess.Content.SkillData
  Id: skill-hitmonlee
  DisplayName: "\uBB34\uB98E\uCC28\uAE30"
  Ranked: 1
  RankOverrides: []
  VariantIds: []
  VariantMode: 0
  Description: "\uD6C4\uBC29\uC758 \uC801\uC5D0\uAC8C \uB6F0\uC5B4\uB4E4\uC5B4 180/250/335\uC758
    \uBB3C\uB9AC \uD53C\uD574\uB97C \uC900\uB2E4. \uC0AC\uC6A9 \uD6C4 \uCD5C\uB300
    HP 8%\uB97C \uC18C\uBAA8\uD55C\uB2E4.\n[AD/AP v4] \uBAA8\uB4E0 \uACE0\uC815 \uC9C1\uC811
    \uD53C\uD574(\uC8FC \uD0C0\uACA9\xB7\uCD94\uAC00 \uD0C0\uACA9\xB7\uAD11\uC5ED\xB7\uD2F1\xB7\uC870\uAC74\uBD80
    \uD53C\uD574)\uC5D0 \uAC01\uAC01 \uAE30\uBCF8 \uC218\uCE58 \xD7 [0.70\xD7(\uD604\uC7AC
    AD/\uB3D9\uC77C \uC131\uAE09 \uAE30\uC900 AD)+0.30\xD7(\uD604\uC7AC AP/100)]
    \uC801\uC6A9. \uD53C\uD574 \uC720\uD615\xB7\uACE0\uC720 \uC0C1\uD0DC\uC774\uC0C1
    \uD53C\uD574\xB7\uAD70\uC911\uC81C\uC5B4 \uC9C0\uC18D\uC2DC\uAC04\uC740 \uC720\uC9C0.\n[\uC608\uC678]
    \uCD5C\uB300 HP 8% \uC18C\uBAA8 \uACE0\uC815; \uB300\uC0C1 \uC120\uC815 \uBC0F
    \uCC29\uC9C0 \uD53C\uACA9 \uD310\uC815 \uD655\uC778"
  Notes: 
  DescriptionTemplate: "\uD6C4\uBC29\uC758 \uC801\uC5D0\uAC8C \uB6F0\uC5B4\uB4E4\uC5B4
    {value:1}\uC758 \uBB3C\uB9AC \uD53C\uD574\uB97C \uC900\uB2E4. \uC0AC\uC6A9 \uD6C4
    \uCD5C\uB300 HP 8%\uB97C \uC18C\uBAA8\uD55C\uB2E4.\n[AD/AP v4] \uBAA8\uB4E0 \uACE0\uC815
    \uC9C1\uC811 \uD53C\uD574(\uC8FC \uD0C0\uACA9\xB7\uCD94\uAC00 \uD0C0\uACA9\xB7\uAD11\uC5ED\xB7\uD2F1\xB7\uC870\uAC74\uBD80
    \uD53C\uD574)\uC5D0 \uAC01\uAC01 \uAE30\uBCF8 \uC218\uCE58 \xD7 [0.70\xD7(\uD604\uC7AC
    AD/\uB3D9\uC77C \uC131\uAE09 \uAE30\uC900 AD)+0.30\xD7(\uD604\uC7AC AP/100)]
    \uC801\uC6A9. \uD53C\uD574 \uC720\uD615\xB7\uACE0\uC720 \uC0C1\uD0DC\uC774\uC0C1
    \uD53C\uD574\xB7\uAD70\uC911\uC81C\uC5B4 \uC9C0\uC18D\uC2DC\uAC04\uC740 \uC720\uC9C0.\n[\uC608\uC678]
    \uCD5C\uB300 HP 8% \uC18C\uBAA8 \uACE0\uC815; \uB300\uC0C1 \uC120\uC815 \uBC0F
    \uCC29\uC9C0 \uD53C\uACA9 \uD310\uC815 \uD655\uC778"
