  Id: skill-pinsir
  DisplayName: "\uAC00\uC704\uC790\uB974\uAE30"
  Ranked: 1
  RankOverrides: []
  VariantIds: []
  VariantMode: 0
  Description: "\uC801\uC5D0\uAC8C 145/200/270\uC758 \uBB3C\uB9AC \uD53C\uD574\uB97C
    \uC900\uB2E4. \uB300\uC0C1\uC758 HP\uAC00 25% \uC774\uD558\uB77C\uBA74 \uC989\uC2DC
    \uCC98\uD615\uD55C\uB2E4.\n[AD/AP v4] \uBAA8\uB4E0 \uACE0\uC815 \uC9C1\uC811
    \uD53C\uD574(\uC8FC \uD0C0\uACA9\xB7\uCD94\uAC00 \uD0C0\uACA9\xB7\uAD11\uC5ED\xB7\uD2F1\xB7\uC870\uAC74\uBD80
    \uD53C\uD574)\uC5D0 \uAC01\uAC01 \uAE30\uBCF8 \uC218\uCE58 \xD7 [0.70\xD7(\uD604\uC7AC
    AD/\uB3D9\uC77C \uC131\uAE09 \uAE30\uC900 AD)+0.30\xD7(\uD604\uC7AC AP/100)]
    \uC801\uC6A9. \uD53C\uD574 \uC720\uD615\xB7\uACE0\uC720 \uC0C1\uD0DC\uC774\uC0C1
    \uD53C\uD574\xB7\uAD70\uC911\uC81C\uC5B4 \uC9C0\uC18D\uC2DC\uAC04\uC740 \uC720\uC9C0.\n[\uC608\uC678]
    \uCCB4\uB825 25% \uC774\uD558 \uCC98\uD615\uC740 \uC870\uAC74\uB9CC \uACE0\uC815;
    \uD53C\uD574 \uACC4\uC218\uB85C \uCC98\uD615 \uC870\uAC74\uC744 \uBCC0\uACBD\uD558\uC9C0
    \uC54A\uC74C"
  Notes: "\uBCF4\uC2A4 \uC608\uC678 \uB9CC\uB4E4\uC9C0 \uB9D0\uACE0 \uC77C\uAD00\uC131\uC788\uAC8C
    \uCC98\uD615"
  DescriptionTemplate: "\uC801\uC5D0\uAC8C {value:0}\uC758 \uBB3C\uB9AC \uD53C\uD574\uB97C
    \uC900\uB2E4. \uB300\uC0C1\uC758 HP\uAC00 25% \uC774\uD558\uB77C\uBA74 \uC989\uC2DC
    \uCC98\uD615\uD55C\uB2E4.\n[AD/AP v4] \uBAA8\uB4E0 \uACE0\uC815 \uC9C1\uC811
    \uD53C\uD574(\uC8FC \uD0C0\uACA9\xB7\uCD94\uAC00 \uD0C0\uACA9\xB7\uAD11\uC5ED\xB7\uD2F1\xB7\uC870\uAC74\uBD80
    \uD53C\uD574)\uC5D0 \uAC01\uAC01 \uAE30\uBCF8 \uC218\uCE58 \xD7 [0.70\xD7(\uD604\uC7AC
    AD/\uB3D9\uC77C \uC131\uAE09 \uAE30\uC900 AD)+0.30\xD7(\uD604\uC7AC AP/100)]
    \uC801\uC6A9. \uD53C\uD574 \uC720\uD615\xB7\uACE0\uC720 \uC0C1\uD0DC\uC774\uC0C1
    \uD53C\uD574\xB7\uAD70\uC911\uC81C\uC5B4 \uC9C0\uC18D\uC2DC\uAC04\uC740 \uC720\uC9C0.\n[\uC608\uC678]
